{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "beckend/main.py",
      "use": "@vercel/python",
      "config": { 
        "installCommand": "pip install -r requirements.txt",
        "maxLambdaSize": "35mb" 
      }
    }
  ],
  "routes": [

    {
      "src": "/api/(.*)",
      "dest": "beckend/main.py" 
    },

    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ],
  "includeFiles": [
    "requirements.txt",
    "beckend/agent/**",
    "beckend/data/**",
    "beckend/chroma_db/**" 
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://huggingface.co/spaces/syaefur/chemis-try-agent-api/:path*"
    }
  ]
}