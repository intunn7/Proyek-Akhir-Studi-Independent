{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  
  "rewrites": [
    {
      "source": "/api/chemistry/:path*",
      
      "destination": "https://syaefur-chemis-try-agent-api.hf.space/:path*"
    }
  ]
}